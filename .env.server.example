# Server-side secrets (Render → Environment). NEVER put these in a VITE_ variable
# and never commit the real values.

# --- ABA PayWay (optional: leave empty and the normal QR + receipt checkout keeps working) ---
ABA_PAYWAY_MERCHANT_ID=
ABA_PAYWAY_API_KEY=
ABA_PAYWAY_ENV=sandbox            # sandbox while testing, production when live
ABA_PAYWAY_PAYMENT_OPTION=abapay_khqr   # abapay_khqr | abapay | cards | bakong ... (must be enabled by ABA for your merchant)
ABA_PAYWAY_CURRENCY=USD
PUBLIC_URL=https://your-service.onrender.com   # the public address of this app (no trailing slash)

# --- Bakong KHQR (dynamic QR per order, confirmed automatically) ---
# Leave BAKONG_API_TOKEN empty and the old checkout keeps working.
BAKONG_API_TOKEN=                       # from Bakong Open API (secret, server only)
BAKONG_ACCOUNT_ID=korn_koemyan@bkrt     # the account that receives the money
BAKONG_MERCHANT_NAME=YN Studio          # shown to the customer in their banking app (max 25 chars)
BAKONG_MERCHANT_CITY=Phnom Penh
BAKONG_CURRENCY=USD                     # USD or KHR
# BAKONG_KHR_RATE=4100                  # only used when BAKONG_CURRENCY=KHR
# BAKONG_QR_MINUTES=10                  # how long each QR stays valid
# BAKONG_API_BASE_URL=https://api-bakong.nbc.gov.kh   # change only if you route through a Cambodian proxy

# The server uses these to read the order amount and to mark it paid after PayWay confirms.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Build-time (Vite) variables still go in .env.example:
#   VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY

# --- Security shield (all optional, sensible defaults) -- see SECURITY-SETUP.md ---
# ALLOW_IPS=203.0.113.5,198.51.100.7   # YOUR home/office IPs: never rate-limited or blocked (also settable in /admin/security)
# CSP_MODE=report                      # report (default: logs only, cannot break the site) | enforce | off
# CSP_CONNECT_EXTRA=https://api.example.com   # extra allowed API hosts for the Content-Security-Policy
# RL_API_PER_MIN=180                   # requests per minute per IP for /api (default 180)
# RL_GLOBAL_PER_MIN=900                # all requests per minute per IP (default 900)
# BLOCK_SCORE=12                       # strike points before an automatic block (default 12)
# HSTS_SUBDOMAINS=0                    # set 1 only if EVERY subdomain of your domain is https
# SECURITY_SHIELD=on                   # set "off" to disable the shield in an emergency (then redeploy)
# TRUSTED_PROXY_CIDRS=                 # extra reverse-proxy ranges, comma separated (normally not needed)
