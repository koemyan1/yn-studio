{
  "name": "yn-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "node server/index.js",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
