    "test:e2e": "node --test tests/e2e-server.test.mjs",
    "security:smoke": "node tools/security-smoke.mjs",
    "schema:coverage": "node tools/schema-coverage.mjs",
    "dev:server": "node server/index.js"
  },
  "dependencies": {
    "@capacitor/core": "^8.0.0",
