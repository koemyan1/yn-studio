    "@zxing/browser": "^0.1.5",
    "bakong-khqr": "^1.0.0",
    "express": "^5.1.0",
    "html-to-image": "^1.11.13",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
