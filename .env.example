VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Optional for installed mobile apps; use the public Render service URL, e.g. https://your-service.onrender.com
VITE_API_BASE_URL=

# Phone push notifications (see PUSH-SETUP.md). Public key only - the private key lives in Supabase secrets.
VITE_VAPID_PUBLIC_KEY=

# Cloudflare Turnstile (free bot check for login/sign-up). Leave empty to keep the login page exactly as it is today.
# Public site key only. The SECRET key goes into Supabase (Authentication -> Attack Protection), never here. See SECURITY-SETUP.md.
VITE_TURNSTILE_SITE_KEY=
